# ============================================================
# Oil Spill Detection & Vessel Attribution — Environment Config
# Copy this file to .env and fill in your credentials
# ============================================================

# Database (SQLite for development, swap for PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./oil_spill.db

# Copernicus Marine Environment Monitoring Service (CMEMS) credentials
# Register at: https://marine.copernicus.eu/
CMEMS_USERNAME=your_username
CMEMS_PASSWORD=your_password

# Copernicus Data Space Ecosystem (for SAR data access)
COPERNICUS_USER=your_user
COPERNICUS_PASSWORD=your_password

# Model checkpoint path (relative to project root)
MODEL_CHECKPOINT=models/checkpoints/unet_best.pt

# Data directory paths
SYNTH_DATA_DIR=data/synthetic
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
